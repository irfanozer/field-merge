# Local Docker Compose defaults. Copy this file to .env before changing values.
POSTGRES_DB=fieldmerge
POSTGRES_USER=fieldmerge
POSTGRES_PASSWORD=fieldmerge-local-only

# Ports are deliberately different from EventHarbor and PulseExchange.
FIELDMERGE_FRONTEND_PORT=3002
FIELDMERGE_BACKEND_PORT=8003
FIELDMERGE_POSTGRES_PORT=5434

# Keep browser/API origins explicit in development.
FIELDMERGE_CORS_ORIGINS=["http://localhost:3002","http://127.0.0.1:3002"]
