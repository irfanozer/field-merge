FIELDMERGE_ENVIRONMENT=development
FIELDMERGE_DATABASE_URL=postgresql+asyncpg://fieldmerge:fieldmerge-local-only@localhost:5434/fieldmerge
FIELDMERGE_CORS_ORIGINS=http://localhost:3002
FIELDMERGE_AUTO_CREATE_SCHEMA=true
FIELDMERGE_PUBLIC_DEMO_MODE=false
FIELDMERGE_MAX_PENDING_OPERATIONS=200
FIELDMERGE_MAX_LOG_OPERATIONS=10000
FIELDMERGE_DATABASE_POOL_SIZE=5
FIELDMERGE_DATABASE_MAX_OVERFLOW=2
FIELDMERGE_DATABASE_POOL_TIMEOUT_SECONDS=30
FIELDMERGE_DATABASE_POOL_RECYCLE_SECONDS=300
